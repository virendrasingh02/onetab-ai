# Synapse logging for local development.
#
# Console only — `docker compose logs -f matrix` is the intended reader, and a
# log file inside the container would just grow unread.
version: 1

formatters:
  precise:
    format: '%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(request)s - %(message)s'

handlers:
  console:
    class: logging.StreamHandler
    formatter: precise

loggers:
  synapse.storage.SQL:
    # Every query at DEBUG buries anything useful. INFO keeps the slow-query
    # warnings, which are the only ones worth seeing here.
    level: INFO

  # The appservice transaction pusher. At INFO this reports each failed POST to
  # our API, which is the first thing to check when the bridge looks silent.
  synapse.appservice:
    level: INFO

root:
  level: INFO
  handlers: [console]

disable_existing_loggers: false
