# OneTab AI Local Infrastructure Environment Variables

# PostgreSQL
POSTGRES_DB=onetab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL="postgres://postgres:postgres@localhost:5432/onetab?sslmode=disable"

# Redis
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Matrix Homeserver
MATRIX_PORT=8008
MATRIX_SERVER_NAME=localhost
MATRIX_URL="http://localhost:8008"

# MinIO Object Storage
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Meilisearch Global Search
MEILI_PORT=7700
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY=masterKey123

# Ollama Local AI
OLLAMA_PORT=11434
OLLAMA_URL="http://localhost:11434"

# Qdrant Vector DB
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL="http://localhost:6333"

# --- Multi-Provider AI Platform -------------------------------------------
AI_DEFAULT_PROVIDER="nvidia"
AI_DEFAULT_MODEL="nvidia/nemotron-3-super-120b-a12b"

NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
GOOGLE_AI_API_KEY=""
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
MISTRAL_API_KEY=""
MISTRAL_BASE_URL="https://api.mistral.ai/v1"
XAI_API_KEY=""
XAI_BASE_URL="https://api.x.ai/v1"
TOGETHER_API_KEY=""
TOGETHER_BASE_URL="https://api.together.xyz/v1"
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
COHERE_API_KEY=""
COHERE_BASE_URL="https://api.cohere.com/v2"

