{
  "manifest_version": 3,
  "name": "OneTab AI — Browser Assistant & Capture",
  "version": "1.0.0",
  "description": "AI Anywhere floating prompt, text summarizer, and quick workspace capture.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OneTab AI Assistant"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
