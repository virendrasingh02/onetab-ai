# Public values only: everything prefixed EXPO_PUBLIC_ is compiled into the app.

# API base URL including the /api/v1 prefix. A device/emulator cannot reach the
# dev machine's "localhost": use the LAN IP (e.g. http://192.168.1.20:3000/api/v1),
# 10.0.2.2 for the Android emulator, or a tunnel URL.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api/v1

# Web app origin, used for "Open on web" links (billing checkout, OAuth connects).
EXPO_PUBLIC_WEB_URL=http://192.168.1.20:4200

# Required for production builds (app.config.ts refuses to build without them):
# the stores need these reachable from inside the app.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=

# Optional: host for iOS universal links and verified Android App Links, e.g.
# app.example.com. It must serve /.well-known/apple-app-site-association and
# /.well-known/assetlinks.json for this app.
EXPO_PUBLIC_LINK_HOST=

# Set after `eas init`; required for push notification tokens and EAS builds.
EAS_PROJECT_ID=

# Optional: Expo account/organisation that owns the project.
EXPO_OWNER=
