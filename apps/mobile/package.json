{
  "name": "@org/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export": "expo export --platform android --platform ios --output-dir dist",
    "doctor": "expo-doctor"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "type:app",
      "scope:mobile"
    ],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "command": "node scripts/run-vitest.mjs apps/mobile",
          "cwd": "{workspaceRoot}"
        }
      },
      "bundle": {
        "executor": "nx:run-commands",
        "cache": true,
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "command": "npx expo export --platform android --platform ios --output-dir dist --clear",
          "cwd": "apps/mobile"
        }
      }
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.0.2",
    "@org/api-client": "*",
    "@org/types": "*",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~58.0.14",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  }
}
