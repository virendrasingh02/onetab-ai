# Admin Console Environment Configuration
#
# Relative API URL (/api/v1) routes API calls through the Vite dev server proxy
# to avoid CORS restrictions and support tunnels.
VITE_API_URL=/api/v1

# Target URL of the backend API for Vite server-side proxy
API_URL=http://localhost:3000

# Base URL of the main web workspace app (for SSO return and workspace navigation)
VITE_WEB_APP_URL=http://localhost:4200
