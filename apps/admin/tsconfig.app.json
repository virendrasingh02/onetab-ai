{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["dom"],
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "vite/client"
    ],
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx",
    "vitest.config.mts",
    "src/test-setup.ts"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../../libs/shared/ui/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/design-system/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/api-client/tsconfig.lib.json"
    },
    {
      "path": "../../libs/admin/layout/tsconfig.lib.json"
    },
    {
      "path": "../../libs/admin/analytics/tsconfig.lib.json"
    },
    {
      "path": "../../libs/admin/enterprise/tsconfig.lib.json"
    },
    {
      "path": "../../libs/admin/marketplace/tsconfig.lib.json"
    }
  ]
}
