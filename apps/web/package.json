{
  "name": "@org/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": [
      "type:app",
      "scope:web"
    ],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "outputs": [
          "{projectRoot}/test-output/vitest/coverage"
        ],
        "options": {
          "command": "node scripts/run-vitest.mjs apps/web",
          "cwd": "{workspaceRoot}"
        }
      },
      "build": {
        "options": {
          "env": { "NODE_ENV": "production" }
        }
      }
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@org/realtime": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.3",
    "matrix-js-sdk": "42.0.0"
  }
}
