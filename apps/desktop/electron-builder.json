{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "ai.onetab.desktop",
  "productName": "Onetab AI",
  "copyright": "Copyright © Onetab AI Inc.",
  "directories": {
    "app": "apps/desktop",
    "output": "apps/desktop/release",
    "buildResources": "apps/desktop/resources"
  },
  "electronDist": "node_modules/electron/dist",
  "extraMetadata": {
    "name": "onetab-ai",
    "productName": "Onetab AI",
    "version": "0.0.1",
    "description": "Onetab AI desktop application",
    "author": "Onetab AI Inc."
  },
  "files": [
    "dist/main.js",
    "dist/preload.js",
    "dist/main/**/*",
    "dist/shared/**/*",
    "resources/**/*",
    "!resources/app-update.yml",
    "package.json",
    "!**/*.map",
    "!**/*.d.ts"
  ],
  "extraResources": [
    {
      "from": "apps/web/dist",
      "to": "web"
    },
    {
      "from": "apps/desktop/resources/app-update.yml",
      "to": "app-update.yml"
    }
  ],
  "asar": true,
  "protocols": [
    {
      "name": "Onetab AI Protocol",
      "schemes": ["onetab", "mie"]
    }
  ],
  "win": {
    "target": ["nsis"],
    "icon": "apps/desktop/resources/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.productivity",
    "icon": "apps/desktop/resources/icon.png",
    "hardenedRuntime": true,
    "entitlements": "apps/desktop/resources/entitlements.mac.plist",
    "entitlementsInherit": "apps/desktop/resources/entitlements.mac.plist",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Onetab AI uses your microphone to record voice messages and for huddles and calls.",
      "NSCameraUsageDescription": "Onetab AI uses your camera for video in huddles and calls."
    }
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Office",
    "icon": "apps/desktop/resources/icon.png",
    "desktop": {
      "entry": {
        "MimeType": "x-scheme-handler/onetab;x-scheme-handler/mie;"
      }
    }
  }
}
