{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "ai.onetab.desktop",
  "productName": "OneTab AI",
  "copyright": "Copyright © OneTab AI",
  "directories": {
    "output": "apps/desktop/release",
    "buildResources": "apps/desktop/resources"
  },
  "electronDist": "node_modules/electron/dist",
  "extraMetadata": {
    "name": "onetab-ai",
    "productName": "OneTab AI",
    "version": "0.0.1",
    "description": "OneTab AI desktop app",
    "author": "OneTab AI",
    "main": "apps/desktop/dist/main.js"
  },
  "files": [
    "apps/desktop/dist/main.js",
    "apps/desktop/dist/preload.js",
    "apps/desktop/dist/main/**/*",
    "apps/desktop/dist/shared/**/*",
    "apps/desktop/resources/**/*",
    "apps/desktop/package.json",
    "!**/*.map",
    "!**/*.d.ts",
    "!node_modules/**/*",
    "node_modules/electron-updater/**/*",
    "node_modules/tiny-typed-emitter/**/*",
    "node_modules/builder-util-runtime/**/*",
    "node_modules/js-yaml/**/*",
    "node_modules/lazy-val/**/*",
    "node_modules/lodash.escaperegexp/**/*",
    "node_modules/lodash.isequal/**/*",
    "node_modules/semver/**/*",
    "node_modules/fs-extra/**/*",
    "node_modules/graceful-fs/**/*",
    "node_modules/jsonfile/**/*",
    "node_modules/universalify/**/*",
    "node_modules/argparse/**/*",
    "node_modules/sax/**/*",
    "node_modules/debug/**/*",
    "node_modules/ms/**/*"
  ],
  "extraResources": [
    {
      "from": "apps/web/dist",
      "to": "web"
    }
  ],
  "asar": true,
  "protocols": [
    {
      "name": "OneTab AI",
      "schemes": ["onetab"]
    }
  ],
  "win": {
    "target": ["nsis"],
    "icon": "apps/desktop/resources/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.productivity",
    "icon": "apps/desktop/resources/icon.png",
    "hardenedRuntime": true,
    "entitlements": "apps/desktop/resources/entitlements.mac.plist",
    "entitlementsInherit": "apps/desktop/resources/entitlements.mac.plist"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Office",
    "icon": "apps/desktop/resources/icon.png",
    "desktop": {
      "entry": {
        "MimeType": "x-scheme-handler/onetab;"
      }
    }
  }
}
