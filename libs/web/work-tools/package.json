{
  "name": "@org/web-work-tools",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@org/api-client": "*",
    "@org/auth": "*",
    "@org/design-system": "*",
    "@org/media-preview": "*",
    "@org/notifications": "*",
    "@org/realtime": "*",
    "@org/types": "*",
    "@org/ui": "*",
    "@org/utils": "*",
    "@org/validation": "*",
    "@org/web-integrations": "*",
    "@org/web-upload": "*",
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^1.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@org/icons": "*"
  },
  "nx": {
    "tags": [
      "type:feature",
      "scope:web"
    ],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "outputs": [
          "{projectRoot}/test-output/vitest/coverage"
        ],
        "options": {
          "command": "node scripts/run-vitest.mjs libs/web/work-tools",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  }
}
