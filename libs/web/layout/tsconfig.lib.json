    },
    {
      "path": "../search/tsconfig.lib.json"
    },
    {
      "path": "../members/tsconfig.lib.json"
    },
    {
      "path": "../desktop/tsconfig.lib.json"
    },
    {
      "path": "../chat/tsconfig.lib.json"
    },
    {
      "path": "../ai/tsconfig.lib.json"
    },
    {
