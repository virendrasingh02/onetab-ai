{
  "name": "@org/web-layout",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "type:feature",
      "scope:web"
    ],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "outputs": [
          "{projectRoot}/test-output/vitest/coverage"
        ],
        "options": {
          "command": "node scripts/run-vitest.mjs libs/web/layout",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "type": "module",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.7.1",
    "@org/chat-ui": "*",
    "@org/hooks": "*",
    "@org/notifications": "*",
    "@org/web-ai": "*",
    "@org/web-chat": "*",
    "@org/web-desktop": "0.0.1",
    "@org/web-members": "*",
    "@org/web-profile": "*",
    "@org/web-search": "*",
    "@org/web-work-tools": "*",
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^1.28.0",
    "react-hook-form": "^7.84.0",
    "react-router-dom": "^6.30.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
