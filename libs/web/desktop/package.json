{
  "name": "@org/web-desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react-router-dom": "^6.30.3"
  },
  "nx": {
    "tags": ["type:feature", "scope:web"],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --config libs/web/desktop/vitest.config.mts"
        }
      }
    }
  }
}
