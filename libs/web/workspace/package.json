{
  "name": "@org/web-workspace",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "type:feature",
      "scope:web"
    ],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "outputs": [
          "{projectRoot}/test-output/vitest/coverage"
        ],
        "options": {
          "command": "vitest run --passWithNoTests",
          "cwd": "libs/web/workspace"
        }
      }
    }
  },
  "type": "module",
  "dependencies": {
    "@org/web-desktop": "0.0.1",
    "@hookform/resolvers": "^5.7.1",
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^1.28.0",
    "react-hook-form": "^7.84.0",
    "react-router-dom": "^6.30.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14",
    "@org/icons": "*",
    "@org/notifications": "*",
    "@org/analytics-ui": "*",
    "@org/common": "*",
    "@org/design-system": "*",
    "@org/ui": "*",
    "@org/utils": "*",
    "@org/types": "*",
    "@org/validation": "*"
  }
}
