{
  "name": "@org/sync",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@org/api-client": "*",
    "@org/realtime": "*",
    "@org/types": "*",
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.0.0",
    "zustand": "^5.0.14"
  },
  "nx": {
    "tags": [
      "type:data-access",
      "scope:shared"
    ],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "outputs": [
          "{projectRoot}/test-output/vitest/coverage"
        ],
        "options": {
          "command": "node scripts/run-vitest.mjs libs/shared/sync",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  }
}
