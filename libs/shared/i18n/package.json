{
  "name": "@org/i18n",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@org/types": "*",
    "@org/validation": "*",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "nx": {
    "tags": [
      "type:util",
      "scope:shared"
    ],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "command": "node scripts/run-vitest.mjs libs/shared/i18n",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  }
}
