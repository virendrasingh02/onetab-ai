{
  "name": "@org/icons",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "type:feature",
      "scope:shared"
    ],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "outputs": [
          "{projectRoot}/test-output/vitest/coverage"
        ],
        "options": {
          "command": "vitest run --passWithNoTests",
          "cwd": "libs/shared/icons"
        }
      }
    }
  },
  "dependencies": {
    "@org/api-client": "*",
    "@org/types": "*",
    "@org/ui": "*",
    "@org/validation": "*",
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.0.0"
  }
}
