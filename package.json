{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "dev": "nx run-many -t serve -p @org/api @org/web",
    "dev:all": "nx run-many -t serve -p @org/api @org/web @org/admin",
    "dev:all:desktop": "nx run-many -t serve -p @org/api @org/web @org/admin @org/desktop",
    "dev:web": "nx serve @org/web",
    "dev:desktop": "nx run-many -t serve -p @org/api @org/web @org/desktop",
    "desktop:build": "nx build @org/desktop",
    "desktop:package": "nx package @org/desktop",
    "dev:admin": "nx serve @org/admin",
    "dev:api": "nx serve @org/api",
    "tunnel": "cloudflared tunnel --url http://localhost:4200",
    "preview:tunnel": "concurrently -k -n api,web,tunnel -c blue,green,magenta \"nx run @org/api:serve\" \"nx run @org/web:preview\" \"npm run tunnel\"",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:watch": "nx run-many -t test -- --watch",
    "e2e": "nx run @org/api-e2e:e2e",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint -- --fix",
    "typecheck": "nx run-many -t typecheck",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "validate": "nx run-many -t lint typecheck test build",
    "affected": "nx affected -t lint typecheck test build",
    "graph": "nx graph",
    "sync": "nx sync",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed:users": "tsx scripts/seed-test-users.ts",
    "infra:start": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml up -d",
    "infra:stop": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml down",
    "infra:restart": "npm run infra:stop && npm run infra:start",
    "infra:logs": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml logs -f",
    "infra:clean": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml down -v",
    "matrix:start": "docker compose -f docker/matrix/docker-compose.yml up -d",
    "matrix:setup": "node scripts/matrix-dev-setup.mjs",
    "matrix:stop": "docker compose -f docker/matrix/docker-compose.yml down",
    "matrix:restart": "npm run matrix:stop && npm run matrix:start",
    "matrix:logs": "docker compose -f docker/matrix/docker-compose.yml logs -f matrix",
    "matrix:reset": "docker compose -f docker/matrix/docker-compose.yml down -v",
    "start:dev": "npm run infra:start && npm run dev",
    "start:full": "npm run infra:start && npm run dev:all",
    "start:chat": "npm run matrix:start && npm run matrix:setup && npm run dev"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@commitlint/config-conventional": "^21.2.0",
