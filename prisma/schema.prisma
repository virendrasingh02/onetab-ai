model MarketplacePublisher {
  id           String               @id @default(cuid())
  /// Null for first-party/official listings that no user account owns.
  userId       String?
  name         String
  slug         String               @unique
  websiteUrl   String?
  supportEmail String?
  /// Set once identity and ownership of the publisher domain are confirmed.
  isVerified   Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  listings     MarketplaceListing[]
  user         User?                @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("marketplace_publishers")
}

model MarketplaceListing {
  id                 String                    @id @default(cuid())
  publisherId        String?
  /// PLUGIN, THEME, AGENT, WORKFLOW, COMPONENT, INTEGRATION, TEMPLATE
  kind               String
  slug               String                    @unique
  name               String
  tagline            String                    @default("")
  description        String                    @default("")
  category           String
  version            String                    @default("1.0.0")
  iconUrl            String?
  previewUrl         String?
  /// JSON array of free-text tags.
  tags               String                    @default("[]")
  /// Declared manifest: SDK version, requested scopes, entry points.
  manifestJson       String                    @default("{}")
  /// Kind-specific body — theme tokens, workflow graph, component source, …
  payloadJson        String                    @default("{}")
  pricingModel       String                    @default("FREE")
  priceCents         Int                       @default(0)
  status             String                    @default("PUBLISHED")
  isOfficial         Boolean                   @default(false)
  isFeatured         Boolean                   @default(false)
  installCount       Int                       @default(0)
  /// Sum and count rather than an average, so a new review is one atomic
  /// increment instead of a read-modify-write of the mean.
  ratingSum          Int                       @default(0)
  ratingCount        Int                       @default(0)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  publishedAt        DateTime?
  installations      MarketplaceInstallation[]
  publisher          MarketplacePublisher?     @relation(fields: [publisherId], references: [id])
  reviews            MarketplaceReview[]
  pluginRegistration PluginRegistration?

  @@index([kind, status])
  @@index([kind, category])
  @@index([status, isFeatured])
  @@map("marketplace_listings")
}

model MarketplaceInstallation {
  id            String             @id @default(cuid())
  listingId     String
  workspaceId   String
  installedById String?
  version       String             @default("1.0.0")
  status        String             @default("ACTIVE")
  settingsJson  String             @default("{}")
  /// Scopes the workspace admin actually granted, which may be narrower than
  /// the manifest requested.
  grantedScopes String             @default("[]")
  installedAt   DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  listing       MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([listingId, workspaceId])
  @@index([workspaceId, status])
  @@map("marketplace_installations")
}

model MarketplaceReview {
  id          String             @id @default(cuid())
  listingId   String
  workspaceId String?
  authorName  String
  rating      Int
  title       String?
  body        String             @default("")
  createdAt   DateTime           @default(now())
  listing     MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@map("marketplace_reviews")
}

/// Plugin SDK registration. Only listings of kind PLUGIN carry one.
model PluginRegistration {
  id           String             @id @default(cuid())
  listingId    String             @unique
  runtime      String             @default("SANDBOXED_JS")
  sdkVersion   String             @default("1.0.0")
  entryPoint   String?
  webhookUrl   String?
  /// SHA-256 of the issued key. The plaintext is returned once, at issue time.
  apiKeyHash   String?
  apiKeyPrefix String?
  /// JSON array of scopes the plugin declares it needs.
  scopes       String             @default("[]")
  /// JSON array of UI surfaces the plugin contributes to.
  surfaces     String             @default("[]")
  status       String             @default("ACTIVE")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  listing      MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("plugin_registrations")
}

/// Platform-wide role. Workspace-level permissions live on WorkspaceMember.
enum SystemRole {
  USER
  SUPPORT
  SUPERADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

/// Lifecycle of a workspace. ARCHIVED is reversible and preserves all data;
/// deletion is not.
enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

/// Lifecycle of one membership. SUSPENDED revokes access without dropping the
/// row, so the role and history survive a later reinstatement.
enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

