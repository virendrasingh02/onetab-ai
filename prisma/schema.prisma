/// A first-class meeting: a scheduled call or huddle with participants, an
/// agenda, running notes, recorded decisions and action items. Distinct from
/// `CalendarEvent` (a bare calendar row) — a meeting can be backed by one via
/// `calendarEventId` so it also appears on the calendar, and its action items
/// are real `Task` rows linked back through `Task.meetingId`.
model Meeting {
  id              String               @id @default(cuid())
  workspaceId     String
  organizerId     String
  projectId       String?
  /// The calendar row this meeting also shows up on, when one was created with
  /// it. One-to-one; deleting the meeting leaves the calendar event in place.
  calendarEventId String?              @unique
  title           String
  description     String?
  /// Free-form agenda (markdown), shown at the top of the meeting detail.
  agenda          String?
  /// A join URL (Zoom / Meet / native huddle) or a physical location.
  location        String?
  status          MeetingStatus        @default(SCHEDULED)
  startAt         DateTime
  endAt           DateTime
  /// When the meeting was actually ended, set by "End meeting". Independent of
  /// the scheduled `endAt`.
  endedAt         DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  /// Soft delete — see Project.deletedAt.
  deletedAt       DateTime?
  organizer       User                 @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project?             @relation(fields: [projectId], references: [id])
  calendarEvent   CalendarEvent?       @relation(fields: [calendarEventId], references: [id])
  participants    MeetingParticipant[]
  notes           MeetingNote[]
  decisions       MeetingDecision[]
  actionItems     Task[]               @relation("MeetingActionItems")

  @@index([workspaceId, startAt])
  @@index([workspaceId, status])
  @@index([workspaceId, deletedAt])
  @@index([projectId])
  @@map("meetings")
}

/// One person invited to a meeting, with their role and RSVP.
