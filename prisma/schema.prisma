generator client {
  provider     = "prisma-client"
  output       = "../libs/api/database/src/generated"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  /// bcrypt digest. Never selected into API responses.
  passwordHash            String
  name                    String
  displayName             String?
  avatarUrl               String?
  bio                     String?
  timezone                String                   @default("UTC")
  systemRole              SystemRole               @default(USER)
  presence                PresenceStatus           @default(OFFLINE)
  statusText              String?
  statusEmoji             String?
  statusExpiresAt         DateTime?
  emailVerifiedAt         DateTime?
  lastSeenAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  /// Bridged Matrix identity, provisioned lazily on first chat use.
  matrixUserId            String?                  @unique
  createdAgents           AIAgent[]
  aiChatSessions          AIChatSession[]
  createdWorkflows        AutomationWorkflow[]
  organizedEvents         CalendarEvent[]
  channelMembers          ChannelMember[]
  createdChannels         Channel[]                @relation("ChannelCreator")
  chatSettings            ChatSettings?
  sentInvitations         Invitation[]             @relation("InvitationSender")
  marketplacePublishers   MarketplacePublisher[]
  notificationPreferences NotificationPreference[]
  passwordResets          PasswordResetToken[]
  pushRegistrations       PushRegistration[]
  recentActivities        RecentActivity[]
  refreshTokens           RefreshToken[]
  taskComments            TaskComment[]
  assignedTasks           Task[]
  uploads                 Upload[]
  whiteboards             Whiteboard[]
  workDocuments           WorkDocument[]
  workspaceMembers        WorkspaceMember[]
  ownedWorkspaces         Workspace[]              @relation("WorkspaceOwner")
  integrations            ExternalIntegration[]
  leadProjects            Project[]                @relation("ProjectLead")
  ownedInitiatives        Initiative[]
  leadModules             Module[]
  createdUpdates          ProjectUpdate[]
  reportedTasks           Task[]                   @relation("TaskReporter")
  workItemActivities      WorkItemActivity[]
  notifications           Notification[]
  sidebarPreference       SidebarPreference?
  themeSetting            ThemeSetting?
  organizedMeetings       Meeting[]                @relation("MeetingOrganizer")
  meetingParticipations   MeetingParticipant[]
  meetingNotes            MeetingNote[]
  meetingDecisions        MeetingDecision[]
  twoFactorAuth           TwoFactorAuth?
  webAuthnCredentials     WebAuthnCredential[]

  @@index([presence, lastSeenAt])
  @@map("users")
}

/// A user's sidebar customization — section/item visibility and order,
/// per-workspace resource ordering, collapsed groups. Server-persisted so it
/// survives logout and follows the user to another device; the client also
/// keeps a localStorage copy for first paint. One row per user; `data` is the
/// client's own partialized store blob, validated loosely on write.
model SidebarPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sidebar_preferences")
}

/// A user's appearance/theme customization — color mode, density, accent,
/// corner radius, and the full custom-theme config (brand colors, gradients,
/// tokens). Server-persisted so it survives logout and follows the user to
/// another device; the client also keeps a localStorage copy for first paint.
/// One row per user; `data` is the client's appearance blob, validated on
/// write against `themeSettingSchema`.
model ThemeSetting {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("theme_settings")
}

model Workspace {
  id                       String                    @id @default(cuid())
  name                     String
  /// Used in URLs: /w/:slug. Globally unique.
  slug                     String                    @unique
  description              String?
  avatarUrl                String?
  /// Object-store key behind `avatarUrl` when the logo was uploaded to us.
  /// Null when the avatar is an external URL, or when there is no avatar.
  avatarKey                String?
  /// A Lucide icon name, an emoji, or an image URL. Independent of the logo:
  /// an uploaded logo wins where both are set, and the icon remains the
  /// fallback if the logo is later removed.
  icon                     String?
  /// Hex tint for `icon`, and only meaningful when `icon` is a Lucide name.
  iconColor                String?
  supportEmail             String?
  accentColor              String?
  defaultLandingView       String                    @default("home")
  allowExternalSharing     Boolean                   @default(true)
  aiProjectRecaps          Boolean                   @default(true)
  ownerId                  String
  /// ARCHIVED freezes the workspace: it stays listed and readable, but every
  /// write is refused. Deletion is separate and irreversible.
  status                   WorkspaceStatus           @default(ACTIVE)
  archivedAt               DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  aiAgents                 AIAgent[]
  aiChatSessions           AIChatSession[]
  aiMemories               AIMemory[]
  analyticsEvents          AnalyticsEvent[]
  automationWorkflows      AutomationWorkflow[]
  calendarEvents           CalendarEvent[]
  channels                 Channel[]
  externalIntegrations     ExternalIntegration[]
  importJobs               ImportJob[]
  invitations              Invitation[]
  marketplaceInstallations MarketplaceInstallation[]
  notificationPreferences  NotificationPreference[]
  projects                 Project[]
  promptTemplates          PromptTemplate[]
  recentActivities         RecentActivity[]
  tasks                    Task[]
  teams                    Team[]
  initiatives              Initiative[]
  epics                    Epic[]
  modules                  Module[]
  cycles                   Cycle[]
  workItemRelations        WorkItemRelation[]
  customFields             WorkItemCustomField[]
  savedViews               SavedView[]
  intakeRequests           IntakeRequest[]
  workItemActivities       WorkItemActivity[]
  uploads                  Upload[]
  whiteboards              Whiteboard[]
  workDocuments            WorkDocument[]
  members                  WorkspaceMember[]
  notifications            Notification[]
  subscription             WorkspaceSubscription?
  enterpriseInquiries      EnterpriseSalesInquiry[]
  meetings                 Meeting[]
  owner                    User                      @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole    @default(MEMBER)
  /// Optional workspace-specific email address. Falls back to user.email when null.
  email       String?
  /// SUSPENDED keeps the row — and so the role and history — while refusing
  /// access, which is what letting someone back in later needs.
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lastSeenAt  DateTime?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@index([workspaceId, status])
  @@map("workspace_members")
}

model Channel {
  id               String                   @id @default(cuid())
  workspaceId      String
  name             String
  /// Unique per workspace, not globally.
  slug             String
  topic            String?
  description      String?
  visibility       ChannelVisibility        @default(PUBLIC)
  isArchived       Boolean                  @default(false)
  archivedAt       DateTime?
  createdById      String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  /// Matrix room backing this channel. Null until chat is first opened.
  matrixRoomId     String?                  @unique
  members          ChannelMember[]
  pins             ChannelPin[]
  invitations      Invitation[]
  createdBy        User                     @relation("ChannelCreator", fields: [createdById], references: [id])
  workspace        Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recentActivities RecentActivity[]
  uploads          Upload[]
  /// Postgres full-text index over name/topic/description. Populated by a
  /// `GENERATED ALWAYS AS (...) STORED` expression defined in the migration —
  /// Prisma cannot express the generator, so this is `Unsupported` and the
  /// column is never written from application code.
  searchVector     Unsupported("tsvector")?

  @@unique([workspaceId, slug])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, visibility])
  @@index([createdById])
  @@index([searchVector], type: Gin)
  @@map("channels")
}

model ChannelMember {
  id         String      @id @default(cuid())
  channelId  String
  userId     String
  role       ChannelRole @default(MEMBER)
  /// Per-user star, drives the "Favorites" sidebar group.
  isFavorite Boolean     @default(false)
  isMuted    Boolean     @default(false)
  lastReadAt DateTime?
  joinedAt   DateTime    @default(now())
  channel    Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId, isFavorite])
  @@index([channelId])
  @@map("channel_members")
}

/// Pinned item in a channel. Phase 2 stores the pin; the target becomes a
/// message reference once messaging lands.
model ChannelPin {
  id         String   @id @default(cuid())
  channelId  String
  title      String
  url        String?
  note       String?
  pinnedById String
  pinnedAt   DateTime @default(now())
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, pinnedAt])
  @@map("channel_pins")
}

model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String?
  role        WorkspaceRole    @default(MEMBER)
  /// SHA-256 of the emailed token or shareable link token. The plaintext is never stored.
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  declinedAt  DateTime?
  revokedAt   DateTime?
  invitedById String
  channelId   String?
  teamId      String?
  projectId   String?
  message     String?
  maxUses     Int?
  useCount    Int              @default(0)
  isLink      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  invitedBy   User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     Channel?         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  team        Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@index([workspaceId, status])
  @@index([channelId])
  @@index([teamId])
  @@index([projectId])
  @@map("invitations")
}

/// Rotating refresh tokens. One row per active session/device.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the token. A DB leak must not yield usable sessions.
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model TwoFactorAuth {
  id          String    @id @default(cuid())
  userId      String    @unique
  secret      String
  isEnabled   Boolean   @default(false)
  verifiedAt  DateTime?
  backupCodes String    @default("[]")
  phoneNumber String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auths")
}

model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    String
  counter      BigInt    @default(0)
  deviceName   String?
  transports   String    @default("[]")
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

/// File upload foundation. Phase 2 records metadata and issues storage keys;
/// the storage driver (S3/R2) plugs in behind StorageService.
model Upload {
  id           String                   @id @default(cuid())
  workspaceId  String
  channelId    String?
  uploaderId   String
  filename     String
  mimeType     String
  /// Bytes.
  size         Int
  /// Opaque key in the object store.
  storageKey   String                   @unique
  checksum     String?
  createdAt    DateTime                 @default(now())
  channel      Channel?                 @relation(fields: [channelId], references: [id])
  uploader     User                     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  workspace    Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Full-text index over filename. Generated column — see the migration.
  searchVector Unsupported("tsvector")?

  @@index([workspaceId, createdAt])
  @@index([channelId, createdAt])
  @@index([uploaderId])
  @@index([searchVector], type: Gin)
  @@map("uploads")
}

/// Per-user, per-workspace notification routing. Consulted by the push bridge.
model NotificationPreference {
  id              String    @id @default(cuid())
  userId          String
  workspaceId     String
  pushEnabled     Boolean   @default(true)
  emailEnabled    Boolean   @default(false)
  /// Only notify for direct mentions rather than every message.
  mentionsOnly    Boolean   @default(false)
  /// Channel ids muted by this user. Denormalised because it is read on every
  /// push decision and never joined against.
  mutedChannelIds String[]  @default([])
  /// Local time window during which pushes are suppressed, e.g. "22:00".
  quietHoursStart String?
  quietHoursEnd   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("notification_preferences")
}

/// A device registered for push. The bridge prunes these when a push is
/// rejected, which is how uninstalled apps stop receiving traffic.
model PushRegistration {
  id                String    @id @default(cuid())
  userId            String
  /// Web Push endpoint or FCM/APNs token. Unique per device.
  pushKey           String    @unique
  appId             String
  deviceDisplayName String?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_registrations")
}

/// Per-user chat presentation preferences.
model ChatSettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  /// Compact hides avatars and tightens spacing.
  density          String   @default("comfortable")
  showReadReceipts Boolean  @default(true)
  sendTypingNotice Boolean  @default(true)
  enterToSend      Boolean  @default(true)
  playSounds       Boolean  @default(true)
  /// Load remote images and link previews automatically.
  autoloadMedia    Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_settings")
}

/// Activity pointer for our own dashboards and unread surfaces.
///
/// Stores the Matrix event id, never the content — resolving it requires the
/// user's own Matrix session, so an encrypted message stays unreadable here.
model RecentActivity {
  id               String       @id @default(cuid())
  workspaceId      String
  channelId        String?
  /// The actor. For chat rows this is the sender; for non-chat rows (a task
  /// created, a project added) it is whoever did it. Null for system events.
  userId           String?
  kind             ActivityKind
  /// Pointer into Matrix. Unique so a retried appservice transaction cannot
  /// record the same event twice.
  matrixEventId    String?      @unique
  /// The thing this activity is about, for deep-linking from the feed. Free of
  /// a foreign key on purpose — the referenced row may be hard-deleted and the
  /// feed entry should outlive it.
  resourceType     String?
  resourceId       String?
  /// A short, already-rendered description for non-chat rows ("created task
  /// WEB-42"). Null for chat rows, which the client renders from the channel.
  summary          String?
  /// Users this event named. Ids only — still no message content — so the
  /// sidebar can tell "something happened" apart from "someone called you".
  mentionedUserIds String[]     @default([])
  occurredAt       DateTime     @default(now())
  channel          Channel?     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user             User?        @relation(fields: [userId], references: [id])
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt])
  @@index([channelId, occurredAt])
  @@map("recent_activity")
}

/// A per-recipient notification: one row per user who should be told about one
/// thing. Distinct from `RecentActivity` (a workspace-wide log with no
/// read state) — this has an addressee and a `readAt`, and drives the bell
/// menu and its unread badge.
model Notification {
  id           String           @id @default(cuid())
  workspaceId  String
  /// Who receives it.
  recipientId  String
  /// Who caused it, for the avatar in the row. Null for system notifications.
  actorId      String?
  kind         NotificationKind
  title        String
  body         String?
  /// Workspace-relative route the row opens, e.g. `tasks/abc123`.
  deepLink     String?
  /// The subject, for dedup / bulk mark-as-read by resource.
  resourceType String?
  resourceId   String?
  readAt       DateTime?
  createdAt    DateTime         @default(now())
  recipient    User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([workspaceId, recipientId])
  @@map("notifications")
}

model Team {
  id             String                @id @default(cuid())
  workspaceId    String
  name           String
  key            String
  description    String?
  icon           String?
  iconColor      String?
  color          String?               @default("#3b82f6")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects       Project[]
  cycles         Cycle[]
  customFields   WorkItemCustomField[]
  savedViews     SavedView[]
  intakeRequests IntakeRequest[]
  tasks          Task[]
  invitations    Invitation[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("teams")
}

model Initiative {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  objective   String?
  description String?
  ownerId     String?
  status      ProjectStatus @default(ACTIVE)
  health      ProjectHealth @default(HEALTHY)
  priority    TaskPriority  @default(MEDIUM)
  targetDate  DateTime?
  color       String?       @default("#8b5cf6")
  icon        String?
  iconColor   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User?         @relation(fields: [ownerId], references: [id])
  projects    Project[]

  @@index([workspaceId, status])
  @@map("initiatives")
}

model Project {
  id                   String                   @id @default(cuid())
  workspaceId          String
  teamId               String?
  leadId               String?
  initiativeId         String?
  name                 String
  slug                 String
  description          String?
  color                String?                  @default("#3b82f6")
  icon                 String?
  iconColor            String?
  status               ProjectStatus            @default(ACTIVE)
  health               ProjectHealth            @default(HEALTHY)
  healthScore          Int?
  startDate            DateTime?
  targetDate           DateTime?
  columnOrder          TaskStatus[]             @default([])
  ticketPrefix         String?
  identifierPrefixMode IdentifierPrefixMode     @default(AUTO)
  ticketSeq            Int                      @default(0)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  milestones           Milestone[]
  workspace            Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team                 Team?                    @relation(fields: [teamId], references: [id])
  lead                 User?                    @relation("ProjectLead", fields: [leadId], references: [id])
  initiative           Initiative?              @relation(fields: [initiativeId], references: [id])
  sprints              Sprint[]
  epics                Epic[]
  modules              Module[]
  cycles               Cycle[]
  customFields         WorkItemCustomField[]
  savedViews           SavedView[]
  intakeRequests       IntakeRequest[]
  updates              ProjectUpdate[]
  tasks                Task[]
  invitations          Invitation[]
  meetings             Meeting[]
  /// Full-text index over name/description. Generated column — see the migration.
  searchVector         Unsupported("tsvector")?

  /// Soft delete. A user-initiated delete sets this instead of removing the
  /// row (and its cascade of tasks); reads filter it out; restore clears it.
  deletedAt DateTime?

  @@unique([workspaceId, slug])
  @@unique([workspaceId, ticketPrefix])
  @@index([workspaceId, status])
  @@index([teamId])
  @@index([initiativeId])
  @@index([workspaceId, deletedAt])
  @@index([searchVector], type: Gin)
  @@map("projects")
}

model Epic {
  id          String        @id @default(cuid())
  projectId   String
  workspaceId String
  name        String
  description String?
  ownerId     String?
  status      ProjectStatus @default(ACTIVE)
  priority    TaskPriority  @default(MEDIUM)
  targetDate  DateTime?
  color       String?       @default("#8b5cf6")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId, status])
  @@map("epics")
}

model Module {
  id          String        @id @default(cuid())
  projectId   String
  workspaceId String
  name        String
  description String?
  leadId      String?
  startDate   DateTime?
  targetDate  DateTime?
  status      ProjectStatus @default(ACTIVE)
  color       String?       @default("#3b82f6")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        User?         @relation(fields: [leadId], references: [id])
  tasks       Task[]

  @@index([projectId, status])
  @@map("modules")
}

model Cycle {
  id          String      @id @default(cuid())
  projectId   String?
  teamId      String?
  workspaceId String
  name        String
  description String?
  goal        String?
  startDate   DateTime
  endDate     DateTime
  status      CycleStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team        Team?       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId, status])
  @@index([teamId, status])
  @@map("cycles")
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId, dueDate])
  @@map("milestones")
}

model Sprint {
  id        String   @id @default(cuid())
  projectId String
  name      String
  goal      String?
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId, isActive])
  @@map("sprints")
}

model Task {
  id              String                   @id @default(cuid())
  workspaceId     String
  projectId       String?
  sprintId        String?
  milestoneId     String?
  /// Primary assignee. Kept for the single-assignee relation and as
  /// `assigneeIds[0]` — the two are always written together.
  assigneeId      String?
  /// Every assignee, primary first. A task can have several; the tile draws an
  /// avatar stack and each assignee is notified and can filter "assigned to me"
  /// on it. Was previously stashed in `customFields.assigneeIds`.
  assigneeIds     String[]                 @default([])
  reporterId      String?
  teamId          String?
  epicId          String?
  cycleId         String?
  moduleId        String?
  parentId        String?
  /// Set when this task is an action item captured from a meeting.
  meetingId       String?
  type            WorkItemType             @default(TASK)
  customTypeId    String?
  title           String
  description     String?
  status          TaskStatus               @default(TODO)
  priority        TaskPriority             @default(MEDIUM)
  startDate       DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  orderIndex      Int                      @default(0)
  ticketNumber    Int?
  identifier      String?
  estimate        Float?
  timeSpent       Int?
  labels          String[]                 @default([])
  customFields    Json?                    @default("{}")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  comments        TaskComment[]
  assignee        User?                    @relation(fields: [assigneeId], references: [id])
  reporter        User?                    @relation("TaskReporter", fields: [reporterId], references: [id])
  milestone       Milestone?               @relation(fields: [milestoneId], references: [id])
  project         Project?                 @relation(fields: [projectId], references: [id])
  team            Team?                    @relation(fields: [teamId], references: [id])
  sprint          Sprint?                  @relation(fields: [sprintId], references: [id])
  epic            Epic?                    @relation(fields: [epicId], references: [id])
  cycle           Cycle?                   @relation(fields: [cycleId], references: [id])
  module          Module?                  @relation(fields: [moduleId], references: [id])
  parent          Task?                    @relation("TaskSubItems", fields: [parentId], references: [id])
  subItems        Task[]                   @relation("TaskSubItems")
  meeting         Meeting?                 @relation("MeetingActionItems", fields: [meetingId], references: [id])
  sourceRelations WorkItemRelation[]       @relation("RelationSource")
  targetRelations WorkItemRelation[]       @relation("RelationTarget")
  activities      WorkItemActivity[]
  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Full-text index over title/description/identifier. Generated column — see the migration.
  searchVector    Unsupported("tsvector")?
  /// Soft delete — see Project.deletedAt.
  deletedAt       DateTime?

  @@unique([projectId, ticketNumber])
  @@index([workspaceId, status])
  @@index([projectId, status])
  @@index([sprintId])
  @@index([cycleId])
  @@index([epicId])
  @@index([moduleId])
  @@index([parentId])
  @@index([meetingId])
  @@index([identifier])
  @@index([workspaceId, deletedAt])
  @@index([assigneeIds], type: Gin)
  @@index([searchVector], type: Gin)
  @@map("tasks")
}

