# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.

# --- Database -------------------------------------------------------------
# Prisma reads this via prisma.config.ts (`import "dotenv/config"`).
# Local Prisma Postgres:  npx prisma dev
# Hosted Prisma Postgres: npx create-db
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- API ------------------------------------------------------------------
PORT=3000
HOST=localhost
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS="http://localhost:4200,http://localhost:4201"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="7d"

# --- Frontends ------------------------------------------------------------
# Only VITE_-prefixed vars are exposed to browser bundles. Never put secrets here.
VITE_API_URL="http://localhost:3000/api"
