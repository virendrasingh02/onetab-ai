# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.

# --- Database -------------------------------------------------------------
# Prisma reads this via prisma.config.ts (`import "dotenv/config"`).
# Local Prisma Postgres:  npx prisma dev
# Hosted Prisma Postgres: npx create-db
# Example local Prisma dev URL (default ports):
DATABASE_URL="postgres://postgres:postgres@localhost:51214/onetab?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"
# Shadow database for `prisma migrate dev` (separate Postgres instance):
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/postgres?sslmode=disable"

# --- API ------------------------------------------------------------------
PORT=3000
HOST=localhost
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS="http://localhost:4200,http://localhost:4201"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
# Rotation on every refresh makes this a sliding window, so it is the time the
# app can go *unopened* before a sign-in is needed again — not a session cap.
JWT_REFRESH_TTL="30d"

# --- Matrix (real-time messaging) -----------------------------------------
# Set to "false" and the API boots and the app runs fully without a homeserver,
# reporting chat as unavailable. When "true", the homeserver URL, the server
# name and one set of privileged credentials are all required.
MATRIX_ENABLED="true"

# The address the *browser* dials. Distinct from MATRIX_SERVER_NAME, which is
# the Matrix identity appearing in user and room ids: this carries a scheme and
# often a port, and that name does not. MATRIX_HOMESERVER is accepted as an
# alias for this.
MATRIX_HOMESERVER_URL="http://localhost:8008"
MATRIX_SERVER_NAME="localhost"

# End-to-end encryption for private channels. It needs a device-bound Matrix
# session per browser, which only `POST /login` issues — and Synapse
# rate-limits that per source address, counting every user's login as coming
# from the API. Leave it on only where the homeserver's `rc_login` has been
# relaxed; otherwise set "false" and sessions come from the admin API instead,
# with private rooms created unencrypted to match.
MATRIX_ENCRYPTION="true"

# --- Privileges: pick ONE of the two blocks below -------------------------
#
# (a) Server admin. Works against any reachable homeserver — nothing has to be
# installed on it. The bridge signs in with these and drives the Synapse admin
# API: provisioning users, opening their sessions, creating and running rooms.
# This is the simpler option and it wins if both blocks are filled in.
MATRIX_USERNAME="admin"
MATRIX_PASSWORD=""

# Optional access token for that account. Saves a `/login` on every API boot,
# which matters because Synapse rate-limits logins hard by default. The bridge
# falls back to the password if the homeserver rejects it.
MATRIX_ADMIN_TOKEN=""

# Salt for the per-user Matrix passwords the bridge derives. Bridged users
# never learn their password, so this only has to be stable and secret; change
# it and every account is repaired on its next sign-in.
# Generate with: openssl rand -hex 24
MATRIX_USER_PASSWORD_SECRET=""

# (b) Application service. Needs config files installed on the homeserver, and
# in exchange gets live event push into the API (notifications, mirroring) that
# option (a) cannot do. For local development, start the throwaway Synapse and
# copy the dev values from docker/matrix/synapse/ into the blanks below:
#
#   npm run matrix:start
#   npm run matrix:setup
#
# The second step is required — see docker/matrix/README.md for why.
#
# Synapse shared-secret registration key. Provisions a Matrix identity once per
# user; never sent to the browser. Must equal `registration_shared_secret` in
# docker/matrix/synapse/homeserver.yaml.
MATRIX_REGISTRATION_SHARED_SECRET=""

# Application service tokens. AS_TOKEN authenticates us to the homeserver;
# HS_TOKEN authenticates the homeserver's calls to /matrix/appservice/*. Both
# must equal their counterparts in docker/matrix/synapse/dev-appservice.yaml —
# Synapse reads that file only at boot, so restart it after any change.
MATRIX_AS_TOKEN=""
MATRIX_HS_TOKEN=""

# --- Rate limiting --------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- Redis (Cache, Session, Queue) ----------------------------------------
REDIS_URL="redis://localhost:6379"

# --- MinIO (Object Storage) -----------------------------------------------
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"

# --- Meilisearch (Global Search) -------------------------------------------
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="masterKey123"

# --- Ollama & Qdrant (Local AI & Vector Search) ---------------------------
OLLAMA_URL="http://localhost:11434"
QDRANT_URL="http://localhost:6333"
MATRIX_URL="http://localhost:8008"

# --- Multi-Provider AI Platform -------------------------------------------
# Default Provider & Model (Temporary Default: NVIDIA Nemotron 3 Super)
AI_DEFAULT_PROVIDER="nvidia"
AI_DEFAULT_MODEL="nvidia/nemotron-3-super-120b-a12b"

# Launch allowlists — which providers/models the picker and AI settings show.
# Adapters stay registered and callable regardless; this only gates what is
# advertised. Leave BOTH blank to surface every provider/model.
AI_ENABLED_PROVIDERS="nvidia,openai,anthropic,gemini"
AI_ENABLED_MODELS="nvidia/nemotron-3-super-120b-a12b,gpt-4o,gpt-4o-mini,claude-sonnet-4-5,gemini-1.5-pro"

# NVIDIA API
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# OpenAI API
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Anthropic API
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

# Google Gemini API
GOOGLE_AI_API_KEY=""

# DeepSeek API
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Groq API
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Mistral AI
MISTRAL_API_KEY=""
MISTRAL_BASE_URL="https://api.mistral.ai/v1"

# xAI (Grok)
XAI_API_KEY=""
XAI_BASE_URL="https://api.x.ai/v1"

# Together AI
TOGETHER_API_KEY=""
TOGETHER_BASE_URL="https://api.together.xyz/v1"

# OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Cohere API
COHERE_API_KEY=""
COHERE_BASE_URL="https://api.cohere.com/v2"

# --- Multi-App API Integrations --------------------------------------------
# Google OAuth 2.0 & Gmail API
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/integrations/gmail/callback"

# App-Level Token Encryption (AES-256-GCM 32-byte secret)
ENCRYPTION_KEY=""

# Custom API Connector settings
CUSTOM_API_TIMEOUT_MS=15000

# --- GIF picker ---------------------------------------------------------------
# Proxies Tenor so the key stays server-side. Leave TENOR_API_KEY blank and the
# /gifs endpoints serve a small bundled fallback set instead.
# Free key: https://developers.google.com/tenor/guides/quickstart
TENOR_API_KEY=""
TENOR_CLIENT_KEY="onetab-ai"

# --- Frontends ------------------------------------------------------------
# Vite only reads env files from the app directory, so this belongs in
# `apps/web/.env.local` (gitignored) rather than here. Optional — the client
# falls back to http://localhost:3000/api/v1 and probes ports 3000-3009 when
# the API has shifted to a free port.
# Only VITE_-prefixed vars are exposed to browser bundles. Never put secrets here.
# VITE_API_URL="http://localhost:3000/api/v1"
#
# Sharing the app through a single Cloudflare Tunnel URL (`npm run
# preview:tunnel`)? Set this to a relative path instead, so the browser calls
# the tunnel's own origin and vite.config.mts proxies it to the local API:
# VITE_API_URL="/api/v1"
