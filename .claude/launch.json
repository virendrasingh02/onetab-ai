{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "nx", "--", "run", "@org/api:serve"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "nx", "--", "run", "@org/web:serve"],
      "port": 4200,
      "autoPort": false
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "nx", "--", "run", "@org/admin:serve"],
      "port": 4201,
      "autoPort": false
    },
    {
      "name": "studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "nx", "--", "run", "@org/ai-agent-studio:serve"],
      "port": 4202,
      "autoPort": false
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "preview",
        "apps/web",
        "--port",
        "4310"
      ],
      "port": 4310,
      "autoPort": false
    },
    {
      "name": "admin-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "preview",
        "apps/admin",
        "--port",
        "4311"
      ],
      "env": { "API_PORT": "3000" },
      "port": 4311,
      "autoPort": false
    },
    {
      "name": "studio-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "preview",
        "apps/ai-agent-studio",
        "--port",
        "4204"
      ],
      "port": 4204,
      "autoPort": false
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8082", "--clear"],
      "cwd": "apps/mobile",
      "env": { "EXPO_PUBLIC_API_URL": "http://localhost:3000/api/v1" },
      "port": 8082
    }
  ]
}
